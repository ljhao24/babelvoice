<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements, used for the app and every helper
  (electron-builder.yml: entitlements + entitlementsInherit). Microphone
  capture runs in both: the native addon in main, getUserMedia in a helper.
-->
<plist version="1.0">
  <dict>
    <!-- V8 -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Native addons (babelvoice_native.node, better-sqlite3) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- The hardened runtime blocks the microphone without this -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
