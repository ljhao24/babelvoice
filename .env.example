# Optional dev-time switches. Copy this file to `.env` (gitignored) to use
# them with `npm run dev`; nothing here is needed to run the app. Translation
# engine API keys are entered in the app (设置 → 翻译服务), not here.

# Log every provider frame (1) or also audio chunks (2) to the terminal.
# DOUBAO_VERBOSE=1
# QWEN_VERBOSE=1
# GEMINI_VERBOSE=1
# OPENAI_VERBOSE=1

# Route provider WebSockets through a proxy (overseas engines from mainland China).
# HTTPS_PROXY=http://127.0.0.1:7890
