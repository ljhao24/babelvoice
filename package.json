{
  "name": "babelvoice",
  "version": "0.1.0",
  "description": "BabelVoice — AI real-time meeting translator (Electron + TypeScript + React)",
  "license": "GPL-3.0-only",
  "repository": "github:ljhao24/babelvoice",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build:native && electron-vite dev",
    "dev:open": "install-electron && electron-vite build && open -n ./node_modules/electron/dist/Electron.app --args \"$PWD\"",
    "dev:web": "vite --config vite.config.web.mjs",
    "build:native": "bash scripts/build-native-audio.sh",
    "build": "npm run build:native && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "build:mac": "npm run build:native && electron-vite build && electron-builder --mac",
    "start": "electron-vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "electron-log": "^5.2.0",
    "electron-store": "^10.0.1",
    "https-proxy-agent": "^7.0.6",
    "protobufjs": "^7.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.7.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/ui": "^4.1.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "electron": "^44.9.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "i18next": "^26.0.8",
    "lucide-react": "^1.61.0",
    "postcss": "^8.4.49",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.6",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.3",
    "uuid": "^14.0.0",
    "vite": "^5.4.11",
    "vitest": "^4.1.5",
    "zustand": "^5.0.1"
  }
}
